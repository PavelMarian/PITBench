   "checker": "canary"
  },
  {
   "class": "wrong_time_column",
   "where": "lineitem.commit_date (planned)",
   "checker": "map_choice"
  },
  {
   "class": "time_inheritance",
   "where": "lineitem has no own time (ts = order_date)",
   "checker": "map_choice"
  }
 ],
